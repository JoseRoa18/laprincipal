# --- Base de datos ---
# Desarrollo: PostgreSQL embebido (pnpm db:start)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/lp2050
# Producción (Supabase): DATABASE_URL = pooler (puerto 6543), DIRECT_URL = conexión directa (5432) para migraciones
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgres://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Autenticación ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
PIN_COOKIE_SECRET=otro-valor-largo-y-aleatorio

# --- Archivos ---
# local (carpeta ./storage) o supabase
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Tareas programadas (Vercel Cron) ---
CRON_SECRET=

# --- Fotos: "Estilo catálogo con IA" (opcional) ---
# Clave de la API de Gemini: https://aistudio.google.com/apikey (crear proyecto con facturación para uso sin límites).
# Modelo gemini-2.5-flash-image: ~1 290 tokens de salida por imagen ≈ US$ 0,04 por foto generada (más ~US$ 0,0001 de entrada).
# Sin esta variable el botón "Estilo catálogo con IA" no aparece; el recorte con fondo blanco en el navegador sigue funcionando.
# GEMINI_API_KEY=

# --- App ---
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost:3000
